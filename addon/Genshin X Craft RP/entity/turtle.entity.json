{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:turtle",
      "materials": {
        "default": "turtle",
        "paradise_eye": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/sea_turtle",
        "baby": "textures/entity/turtle/sea_turtle_baby",
        "paradise_eye": "textures/entity/paradise/creepy_eye"
      },
      "geometry": {
        "default": "geometry.turtle",
        "baby": "geometry.turtle.baby",
        "paradise_eye": "geometry.paradise.creepy_eye.turtle"
      },
      "scripts": {
        "pre_animation": [
          "variable.timeMultiplier = query.has_rider ? 0.39972 : 1.0;",
          "variable.backLegMultiplier = query.has_rider ? 0.5 : 3.0;",
          "variable.frontLegMultiplier = query.has_rider ? 2.0 : 8.0;",
          "variable.legSpeedMultiplier = query.has_rider ? 2.0 : 5.0;"
        ],
        "scale": "query.is_baby ? (1 / 0.16) : 1.0",
        "animate": [
          "general",
          "move_controller",
          {
            "paradise_eye_stare": "variable.paradise_eye_enabled"
          }
        ],
        "initialize": [
          "variable.paradise_eye_enabled = math.random_integer(1, 10) == 1;"
        ]
      },
      "animations": {
        "general": "controller.animation.turtle.general",
        "move": "animation.turtle.move",
        "ground_move": "animation.turtle.ground_move",
        "look_at_target": "animation.common.look_at_target",
        "move_baby": "animation.turtle.baby_move",
        "paradise_eye_stare": "animation.paradise.creepy_eye_stare",
        "move_controller": "controller.animation.turtle.move"
      },
      "render_controllers": [
        "controller.render.turtle.v2",
        "controller.render.paradise_creepy_eye"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_turtle"
      }
    }
  }
}
