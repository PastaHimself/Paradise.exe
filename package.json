{
  "name": "paradise-exe-addon-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "audio:stage": "python tools/stage_audio_manifest.py --write",
    "audio:validate": "python tools/validate_audio_manifest.py",
    "audio:compress": "python tools/compress_audio.py",
    "audio:definitions": "python tools/generate_sound_definitions.py --write"
  },
  "devDependencies": {
    "@minecraft/server": "beta",
    "@minecraft/server-ui": "beta",
    "typescript": "^5.9.3"
  }
}
